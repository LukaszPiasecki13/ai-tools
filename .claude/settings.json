{
  "permissions": {
    "deny": [
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Edit(./secrets/**)",
      "Edit(**/secrets/**)",
      "Write(./secrets/**)",
      "Write(**/secrets/**)",

      "Read(./credentials/**)",
      "Read(**/credentials/**)",
      "Edit(./credentials/**)",
      "Edit(**/credentials/**)",
      "Write(./credentials/**)",
      "Write(**/credentials/**)",

      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",

      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Write(**/*.key)",

      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Write(**/*.p12)",

      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Write(**/*.jks)",

      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Write(**/*.pfx)",

      "Read(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env)",
      "Write(**/.env.local)",

      "Read(**/local.env)",
      "Read(**/local.*)",
      "Edit(**/local.env)",
      "Edit(**/local.*)",
      "Write(**/local.env)",
      "Write(**/local.*)",

      "Read(**/service-account*.json)",
      "Edit(**/service-account*.json)",
      "Write(**/service-account*.json)"
    ]
  }
}
