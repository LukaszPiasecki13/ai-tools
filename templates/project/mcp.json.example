// Copy one of these options to .mcp.json in the project root.
// Keep it out of git if it holds machine-specific paths (e.g., CHROME_PATH on Windows).
// The ui-verify skill needs chrome-devtools; others are optional.

// OPTION 1: npx (default - works everywhere, no setup)
{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}

// OPTION 2: local install (faster, customizable)
// Setup: npm install -g chrome-devtools-mcp
{
  "mcpServers": {
    "chrome-devtools": {
      "command": "chrome-devtools",
      "env": {
        "CHROME_PATH": "/usr/bin/chromium-browser"
      }
    }
  }
}

// OPTION 3: PlatformIO MCP for ESP32 firmware projects (build/flash/monitor tools)
// Setup, inside the project's venv (not globally): pip install platformio-mcp
// (PyPI package "platformio.mcp"; needs Python >= 3.12 and PlatformIO Core installed).
// If pip fails on the "mcp" index page with a gzip/chunked error, download the wheel from
// files.pythonhosted.org and install it with --no-deps.
// Policy: full | build_only | read_only. PROJECT_DIR = folder with platformio.ini.
// Windows venv path shown; on Linux/macOS use ".venv/bin/platformio-mcp".
{
  "mcpServers": {
    "platformio": {
      "command": ".venv/Scripts/platformio-mcp.exe",
      "env": {
        "PLATFORMIO_MCP_POLICY": "full",
        "PLATFORMIO_MCP_PROJECT_DIR": "firmware",
        "PLATFORMIO_MCP_LOG_DIR": ".tmp/platformio-mcp-logs"
      }
    }
  }
}

// Windows CHROME_PATH example:
// "CHROME_PATH": "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"
